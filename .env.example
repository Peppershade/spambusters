# Spambuster Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Flask secret key (REQUIRED - generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Encryption master key for credential storage (REQUIRED for multi-user)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# This key encrypts IMAP/Discord credentials stored in the database.
# Keep this safe - if lost, users will need to re-enter their credentials.
ENCRYPTION_MASTER_KEY=

# =============================================================================
# EMAIL CONFIGURATION (Optional - can configure per-user via web UI)
# =============================================================================
# These settings are used as fallback if user hasn't configured their own.
# For multi-user deployments, leave these empty and let users configure via Settings > Email.

# IMAP_SERVER=imap.gmail.com
# IMAP_PORT=993
# EMAIL_ADDRESS=grandma@example.com
# EMAIL_PASSWORD=your-app-password

# =============================================================================
# DISCORD NOTIFICATIONS (Optional - can configure per-user via web UI)
# =============================================================================
# These settings are used as fallback if user hasn't configured their own.
# For multi-user deployments, leave these empty and let users configure via Settings > Discord.

# Option 1: Webhook only (no interactive buttons)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Option 2: Bot with buttons (requires bot token and channel ID)
# DISCORD_BOT_TOKEN=your-bot-token
# DISCORD_CHANNEL_ID=123456789

# Shared secret for Discord webhook HTTP endpoint
# If set, /api/discord/label requires this token via Authorization header or ?secret= param
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
# DISCORD_WEBHOOK_SECRET=

# Minimum spam score to trigger Discord notification (0.0-1.0)
# DISCORD_NOTIFY_THRESHOLD=0.7

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Operation mode: 'learning' (dryrun) or 'enforcement' (active protection)
# Users can override this in their settings.
OPERATION_MODE=learning

# Spam detection threshold (0.0 to 1.0)
# Higher = fewer false positives, lower = more aggressive
SPAM_THRESHOLD=0.7

# Background scan interval in seconds
SCAN_INTERVAL=300

# Maximum emails to process per scan
MAX_EMAILS_PER_SCAN=50

# Auto-start scanning when the application starts
AUTO_START_SCANNING=true

# =============================================================================
# STORAGE SETTINGS
# =============================================================================

# Deleted email backup settings
# Path to store .eml backup files (per-user subdirectories will be created)
EML_STORAGE_PATH=data/deleted_emails

# How many days to keep backups before auto-cleanup
EML_RETENTION_DAYS=30

# Directory for per-user ML models
MODELS_DIR=models
